{
  "name": "pimpampum",
  "version": "1.2.2",
  "description": "Ultra-minimal local project coordination for solopreneurs and software agents.",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "branding/assets/readme_cover.png",
    "docs",
    "integrations/omarchy",
    "platforms/macos/dist",
    "scripts/check-quattro-evidence.mjs",
    "scripts/check-omarchy-delivery.mjs",
    "scripts/check-omarchy-live-evidence.mjs",
    "scripts/restore-package-manifest.mjs",
    "scripts/validate-omarchy-plugin.mjs",
    "test/fixtures/overview",
    "thoughts/evidence/quattro-live.example.json",
    "thoughts/evidence/omarchy-live.example.json",
    "README.md"
  ],
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "pimpampum": "dist/cli.js",
    "pimpampum-mcp": "dist/mcpStdio.js"
  },
  "scripts": {
    "clean": "node --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "node scripts/prepare-package.mjs",
    "postpack": "node scripts/restore-package-manifest.mjs",
    "dev": "tsx watch src/daemon.ts",
    "start": "node dist/daemon.js",
    "cli": "tsx src/cli.ts",
    "mcp:stdio": "tsx src/mcpStdio.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src test --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:desktop-contract": "node scripts/check-desktop-status-contract.mjs",
    "check:macos-evidence": "node scripts/check-macos-evidence.mjs",
    "check:quattro-evidence": "node scripts/check-quattro-evidence.mjs",
    "benchmark:overview": "tsx scripts/benchmark-overview.ts",
    "build:macos": "./scripts/build-macos-app.sh",
    "approve:macos": "npm run build:macos && node scripts/check-macos-artifact.mjs platforms/macos/dist/PimpampumMenuBar.app --approve",
    "test:macos": "./scripts/check-swift-coverage.sh",
    "validate:omarchy": "node scripts/validate-omarchy-plugin.mjs && node scripts/check-omarchy-delivery.mjs",
    "test:omarchy": "npm run validate:omarchy && vitest run test/omarchy-plugin.test.ts test/service-omarchy.test.ts",
    "test": "npm run build && npm run test:coverage && vitest run test/e2e.test.ts test/development-sessions.e2e.test.ts",
    "test:coverage": "vitest run --coverage --test-timeout=60000 --exclude test/e2e.test.ts --exclude 'test/**/*.e2e.test.ts'",
    "test:unit": "vitest run --exclude test/e2e.test.ts --exclude 'test/**/*.e2e.test.ts'",
    "test:e2e": "npm run build && vitest run test/e2e.test.ts test/development-sessions.e2e.test.ts",
    "test:evals": "npm run test:e2e",
    "test:e2e:macos": "node scripts/test-macos-live.mjs",
    "test:e2e:omarchy:live": "npm run build && node scripts/test-omarchy-live.mjs",
    "test:e2e:omarchy": "npm run validate:omarchy"
  },
  "keywords": [
    "agent-first",
    "agents",
    "local-first",
    "mcp",
    "project-management",
    "solopreneur",
    "specifications",
    "sqlite"
  ],
  "author": "Roberto Díaz",
  "license": "MIT",
  "homepage": "https://github.com/r-bart/pimpampum#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r-bart/pimpampum.git"
  },
  "bugs": {
    "url": "https://github.com/r-bart/pimpampum/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "oxlint": "^1.79.0",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
