---
/*
 * The approved compact mark: one circle containing a lowercase p.
 * Geometry copied verbatim from branding/assets/pimpampum-compact-master.svg,
 * so the web mark and the desktop mark share one silhouette.
 *
 * `decorative` drops it from the accessibility tree — use it when adjacent
 * text already names the product.
 */
interface Props {
  size?: number;
  decorative?: boolean;
  class?: string;
}

const { size = 16, decorative = false, class: className } = Astro.props;
const a11y = decorative
  ? { 'aria-hidden': 'true' }
  : { role: 'img', 'aria-label': 'Pimpampum' };
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="currentColor"
  class={className}
  {...a11y}
>
  <path
    fill-rule="evenodd"
    d="M8 .5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 1 1 0-15zM4.8 3.9h1.4v.7c.7-.6 1.6-.9 2.6-.9 2 0 3.2 1.4 3.2 3.5 0 2-1.3 3.4-3.2 3.4-1 0-1.9-.3-2.6-.9v2.9H4.8V3.9zM6.3 7.2c0-1.3.9-2.2 2.2-2.2s2.1.9 2.1 2.2-.8 2.1-2.1 2.1-2.2-.8-2.2-2.1z"
  ></path>
</svg>

<style>
  svg {
    display: block;
    flex: none;
  }
</style>
