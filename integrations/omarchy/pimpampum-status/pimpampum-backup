#!/usr/bin/env bash
set -euo pipefail

case ${1:-} in
  status|retry|disable)
    [[ $# -eq 1 ]] || { printf '%s\n' 'pimpampum-backup: invalid arguments' >&2; exit 64; }
    ;;
  configure)
    [[ $# -eq 2 ]] || { printf '%s\n' 'pimpampum-backup: configure requires one directory' >&2; exit 64; }
    ;;
  *)
    printf '%s\n' 'pimpampum-backup: expected status, configure, retry, or disable' >&2
    exit 64
    ;;
esac

if [[ -n ${PIMPAMPUM_CLI:-} && ${PIMPAMPUM_CLI:0:1} == / && -x $PIMPAMPUM_CLI ]]; then
  exec "$PIMPAMPUM_CLI" backup "$@"
fi

if [[ -x ${HOME}/.local/bin/pimpampum ]]; then
  exec "${HOME}/.local/bin/pimpampum" backup "$@"
fi

pimpampum_cli=$(command -v pimpampum || true)
if [[ -z $pimpampum_cli || ${pimpampum_cli:0:1} != / || ! -x $pimpampum_cli ]]; then
  printf '%s\n' 'pimpampum-backup: no absolute Pimpampum CLI executable was found' >&2
  exit 127
fi

exec "$pimpampum_cli" backup "$@"
