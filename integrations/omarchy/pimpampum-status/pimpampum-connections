#!/bin/sh
set -eu

umask 077
PATH=/usr/bin:/bin
export PATH

helper_name=pimpampum-connections
plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 70
[ -f "$plugin_root/pimpampum-common.sh" ] && [ ! -L "$plugin_root/pimpampum-common.sh" ] || exit 70
. "$plugin_root/pimpampum-common.sh"

fail() {
  code=$1
  action=$2
  error_code=$3
  printf '{"schemaVersion":1,"ok":false,"action":"%s","code":"%s"}\n' \
    "$action" "$error_code" >&2
  exit "$code"
}

# The shared HOME and runtime-install-receipt.json checks (which prove the receipt owns the control
# launcher) report through this hook; QML branches on the stable code, not on prose.
fail_typed() {
  fail "$1" "$action" "$2"
}

# A failed CLI invocation forwards the typed envelope code and one bounded line of its message,
# so a stopped daemon, a missing agent CLI and a real connector failure read differently.
fail_command() {
  cli_code_json=null
  [ -z "$3" ] || cli_code_json="\"$3\""
  cli_message_json=null
  [ -z "$4" ] || cli_message_json="\"$4\""
  printf '{"schemaVersion":1,"ok":false,"action":"%s","code":"%s","cliCode":%s,"message":%s}\n' \
    "$action" "$2" "$cli_code_json" "$cli_message_json" >&2
  exit "$1"
}

action=${1:-}
connector_id=${2:-}
case $action in
  list | resume)
    [ "$#" -eq 1 ] || fail 64 "$action" invalid_arguments
    connector_id=''
    ;;
  plan | connect | test | disconnect)
    [ "$#" -eq 2 ] || fail 64 "$action" invalid_arguments
    case $connector_id in
      codex | claude-code) ;;
      *) fail 64 "$action" invalid_connector ;;
    esac
    ;;
  repair)
    { [ "$#" -eq 2 ] || { [ "$#" -eq 3 ] && [ "$3" = replace ]; }; } ||
      fail 64 "$action" invalid_arguments
    case $connector_id in
      codex | claude-code) ;;
      *) fail 64 "$action" invalid_connector ;;
    esac
    ;;
  *) fail 64 unknown invalid_action ;;
esac

validate_home 73
verify_control_launcher 69

lock_directory="$data_directory/.connections-helper.lock"
lock_nonce="$$-$(/bin/date +%s)"
lock_owner="$lock_directory/owner"
if ! /bin/mkdir "$lock_directory" 2>/dev/null; then
  [ -d "$lock_directory" ] && [ ! -L "$lock_directory" ] ||
    fail 75 "$action" operation_in_progress
  [ -f "$lock_owner" ] && [ ! -L "$lock_owner" ] ||
    fail 75 "$action" operation_in_progress
  owner_pid=$(/usr/bin/awk -F: 'NR == 1 { print $1 }' "$lock_owner")
  owner_nonce=$(/usr/bin/awk -F: 'NR == 1 { print $2 }' "$lock_owner")
  case $owner_pid in '' | *[!0-9]*) fail 75 "$action" operation_in_progress ;; esac
  [ "$owner_pid" -gt 1 ] && [ -n "$owner_nonce" ] || fail 75 "$action" operation_in_progress
  if /bin/kill -0 "$owner_pid" 2>/dev/null; then
    fail 75 "$action" operation_in_progress
  fi
  owner_value=$(/bin/cat "$lock_owner")
  [ "$owner_value" = "$owner_pid:$owner_nonce" ] || fail 75 "$action" operation_in_progress
  /bin/rm -f -- "$lock_owner" || fail 75 "$action" operation_in_progress
  /bin/rmdir "$lock_directory" || fail 75 "$action" operation_in_progress
  /bin/mkdir "$lock_directory" || fail 75 "$action" operation_in_progress
fi
printf '%s:%s\n' "$$" "$lock_nonce" > "$lock_owner" || {
  /bin/rmdir "$lock_directory" 2>/dev/null || true
  fail 73 "$action" staging_unavailable
}
work_directory=$(/usr/bin/mktemp -d "$data_directory/.connections-helper.XXXXXX") || {
  /bin/rm -f -- "$lock_owner"
  /bin/rmdir "$lock_directory"
  fail 73 "$action" staging_unavailable
}
stdout_file="$work_directory/stdout"
stderr_file="$work_directory/stderr"

cleanup() {
  /bin/rm -rf -- "$work_directory"
  if [ -f "$lock_owner" ] && [ ! -L "$lock_owner" ] &&
    [ "$(/bin/cat "$lock_owner" 2>/dev/null || true)" = "$$:$lock_nonce" ]; then
    /bin/rm -f -- "$lock_owner"
    /bin/rmdir "$lock_directory" 2>/dev/null || true
  fi
}
trap cleanup EXIT HUP INT TERM

case $action in
  list | test) set -- connections ;;
  plan) set -- setup plan --connector "$connector_id" ;;
  connect) set -- connect "$connector_id" --yes ;;
  repair)
    if [ "${3:-}" = replace ]; then set -- repair "$connector_id" --yes --replace
    else set -- repair "$connector_id" --yes
    fi
    ;;
  disconnect) set -- disconnect "$connector_id" --yes ;;
  resume) set -- setup resume ;;
esac

timeout_command=${PIMPAMPUM_CONNECTIONS_TIMEOUT:-/usr/bin/timeout}
case $timeout_command in
  /*) ;;
  *) fail 69 "$action" timeout_unavailable ;;
esac
[ -x "$timeout_command" ] || fail 69 "$action" timeout_unavailable
[ ! -L "$timeout_command" ] || fail 69 "$action" timeout_unavailable

# No file-size limit here: the CLI rewrites the agent's own host configuration, which carries the
# agent's per-project history and often exceeds 64 KiB; the former shell file-size cap killed that
# rewrite with EFBIG. Only the helper's captured output is bounded, below.
exit_code=0
"$timeout_command" --signal=TERM --kill-after=2 30 \
  "$control_launcher" "$@" > "$stdout_file" 2> "$stderr_file" || exit_code=$?

stdout_bytes=$(/usr/bin/wc -c < "$stdout_file" | /usr/bin/tr -d '[:space:]')
stderr_bytes=$(/usr/bin/wc -c < "$stderr_file" | /usr/bin/tr -d '[:space:]')
[ "$stdout_bytes" -le 65536 ] && [ "$stderr_bytes" -le 65536 ] ||
  fail 70 "$action" output_limit
[ "$exit_code" -eq 0 ] || {
  [ "$exit_code" -ne 124 ] && [ "$exit_code" -ne 137 ] || fail 70 "$action" timeout
  # The CLI writes `{"error":{"code":…,"message":…}}` to stderr. Keep the code only when it is a
  # plain identifier, and keep printable ASCII of the message without quotes or backslashes so the
  # value embeds in this helper's own one-line JSON without escaping.
  cli_code=$(/usr/bin/awk '
    match($0, /"code"[[:space:]]*:[[:space:]]*"[a-z_]+"/) {
      value = substr($0, RSTART, RLENGTH)
      sub(/^"code"[[:space:]]*:[[:space:]]*"/, "", value)
      sub(/"$/, "", value)
      print value
      exit
    }' "$stderr_file")
  printf '%s\n' "$cli_code" | /usr/bin/grep -Eq '^[a-z_]{1,40}$' || cli_code=''
  cli_message=$(/usr/bin/awk '
    match($0, /"message"[[:space:]]*:[[:space:]]*"/) {
      value = substr($0, RSTART + RLENGTH)
      gsub(/\\"/, "\047", value)
      sub(/".*$/, "", value)
      print value
      exit
    }' "$stderr_file" | /usr/bin/tr -cd '\040-\041\043-\133\135-\176' | /usr/bin/cut -c1-200)
  [ "$cli_code" != conflict ] || fail_command 70 connector_conflict "$cli_code" "$cli_message"
  fail_command 70 command_failed "$cli_code" "$cli_message"
}

payload=$(/bin/cat "$stdout_file")
case $payload in
  \{*\} | \[*\]) ;;
  *) fail 70 "$action" invalid_response ;;
esac

if [ -n "$connector_id" ]; then
  printf '{"schemaVersion":1,"ok":true,"action":"%s","connectorId":"%s","result":%s}\n' \
    "$action" "$connector_id" "$payload"
else
  printf '{"schemaVersion":1,"ok":true,"action":"%s","connectorId":null,"result":%s}\n' \
    "$action" "$payload"
fi
