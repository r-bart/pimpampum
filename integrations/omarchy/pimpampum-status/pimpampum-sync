#!/usr/bin/env bash
set -euo pipefail

case ${1:-} in
  status|now|pause|resume|conflicts|forget)
    [[ $# -eq 1 ]] || { printf '%s\n' 'pimpampum-sync: invalid arguments' >&2; exit 64; }
    ;;
  configure)
    [[ $# -eq 2 ]] || { printf '%s\n' 'pimpampum-sync: configure requires one directory' >&2; exit 64; }
    ;;
  *)
    printf '%s\n' 'pimpampum-sync: expected status, configure, now, pause, resume, conflicts, or forget' >&2
    exit 64
    ;;
esac

if [[ -n ${PIMPAMPUM_CLI:-} && ${PIMPAMPUM_CLI:0:1} == / && -x $PIMPAMPUM_CLI ]]; then
  pimpampum_cli=$PIMPAMPUM_CLI
elif [[ -x ${HOME}/.local/bin/pimpampum ]]; then
  pimpampum_cli=${HOME}/.local/bin/pimpampum
else
  pimpampum_cli=$(command -v pimpampum || true)
fi

if [[ -z ${pimpampum_cli:-} || ${pimpampum_cli:0:1} != / || ! -x $pimpampum_cli ]]; then
  printf '%s\n' 'pimpampum-sync: no absolute Pimpampum CLI executable was found' >&2
  exit 127
fi

if [[ $1 == configure ]]; then
  device_id=$(hostname | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-63)
  [[ -n $device_id ]] || device_id=linux
  exec "$pimpampum_cli" sync configure "$2" --device "$device_id" --json
fi

exec "$pimpampum_cli" sync "$1" --json
