#!/bin/sh
set -eu

umask 077
PATH=/usr/bin:/bin
export PATH

helper_name=pimpampum-control-route
plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 70
[ -f "$plugin_root/pimpampum-common.sh" ] && [ ! -L "$plugin_root/pimpampum-common.sh" ] || exit 70
. "$plugin_root/pimpampum-common.sh"

surface=${1:-}
[ "$#" -ge 1 ] || fail 69 'missing bounded surface'
shift

validate_home 69
verify_control_launcher 69

case $surface in
  overview)
    [ "$#" -eq 0 ] || fail 69 'overview accepts no arguments'
    set -- overview
    ;;
  backup)
    action=${1:-}
    case $action in
      status | retry | disable) [ "$#" -eq 1 ] || fail 69 'invalid backup arguments' ;;
      configure) [ "$#" -eq 2 ] || fail 69 'backup configure requires one directory' ;;
      *) fail 69 'invalid backup action' ;;
    esac
    set -- backup "$@"
    ;;
  sync)
    action=${1:-}
    case $action in
      status | now | pause | resume | conflicts | forget)
        [ "$#" -eq 1 ] || fail 69 'invalid sync arguments'
        set -- sync "$action" --json
        ;;
      configure)
        [ "$#" -eq 2 ] || fail 69 'sync configure requires one directory'
        # `uname -n` is part of coreutils on every Omarchy install; `hostname` is a separate
        # package there. A device id that collapses to nothing is an error, not a shared `linux`.
        device_id=$(/usr/bin/uname -n | /usr/bin/tr '[:upper:]' '[:lower:]' |
          /usr/bin/sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | /usr/bin/cut -c1-63)
        [ -n "$device_id" ] || fail 69 'cannot derive a device id from the hostname'
        set -- sync configure "$2" --device "$device_id" --json
        ;;
      *) fail 69 'invalid sync action' ;;
    esac
    ;;
  update)
    action=${1:-check}
    [ "$#" -le 1 ] || fail 69 'invalid update arguments'
    case $action in
      check) set -- update:check ;;
      install) set -- update ;;
      *) fail 69 'invalid update action' ;;
    esac
    ;;
  workspace)
    # `workspace add DIRECTORY [NAME]` is the one registration the popout offers: the folder the
    # user picked becomes `workspace:add ID NAME DIRECTORY`, with the name defaulting to the folder
    # name and the id derived from the name by the CLI's slug rule. The daemon validates again.
    action=${1:-}
    [ "$action" = add ] || fail 69 'invalid workspace action'
    [ "$#" -eq 2 ] || [ "$#" -eq 3 ] ||
      fail 69 'workspace add requires one directory and an optional name'
    workspace_root=$2
    case $workspace_root in
      /?*) ;;
      *) fail 69 'workspace directory must be an absolute path' ;;
    esac
    case $workspace_root in
      *[[:cntrl:]]*) fail 69 'workspace directory contains control characters' ;;
    esac
    [ "${#workspace_root}" -le 4096 ] || fail 69 'workspace directory path is too long'
    workspace_name=${3:-$(/usr/bin/basename -- "$workspace_root")}
    case $workspace_name in
      *[[:cntrl:]]*) fail 69 'workspace name contains control characters' ;;
    esac
    [ -n "$workspace_name" ] && [ "${#workspace_name}" -le 120 ] ||
      fail 69 'workspace name must be 1 to 120 characters'
    workspace_id=$(printf '%s' "$workspace_name" | /usr/bin/tr '[:upper:]' '[:lower:]' |
      /usr/bin/sed -E 's/[^a-z0-9]+/-/g; s/^-+//' | /usr/bin/cut -c1-80 |
      /usr/bin/sed -E 's/-+$//')
    [ -n "$workspace_id" ] || fail 69 'cannot derive a workspace id from the folder name'
    set -- workspace:add "$workspace_id" "$workspace_name" "$workspace_root"
    ;;
  *) fail 69 'unknown bounded surface' ;;
esac

exec "$control_launcher" "$@"
